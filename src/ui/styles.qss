
QSplitter::handle {
    background-color: #ccc;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QTableWidget {
    background-color: #fff;
    gridline-color: #ddd;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12px;
}

QTableWidget::item {
    padding: 2px 4px;
}

QTableWidget QHeaderView::section {
    background-color: #e8e8e8;
    border: 1px solid #ccc;
    padding: 2px 4px;
    font-size: 11px;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #ccc;
    border-radius: 4px;
    margin-top: 8px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

QLabel {
    font-size: 13px;
}

QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #fff;
    border: 1px solid #bbb;
    border-radius: 3px;
    padding: 2px 4px;
    font-size: 13px;
}

QStatusBar {
    background-color: #e0e0e0;
    border-top: 1px solid #ccc;
    font-size: 12px;
}

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #bbb;
    border-radius: 3px;
    padding: 4px 12px;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #c8dff0;
}

QPushButton:pressed {
    background-color: #a0c0e0;
}

/* ---- Value labels (stats, aux, device info panels) ---- */
QLabel[class="value"] {
    font-weight: bold;
}

/* ---- Green action buttons (start acquisition, replay play) ---- */
QPushButton[class="btn-green"] {
    background-color: #27ae60;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    font-size: 13px;
    min-height: 24px;
}

QPushButton[class="btn-green"]:hover {
    background-color: #2ecc71;
}

QPushButton[class="btn-green"]:pressed {
    background-color: #1e8449;
}

QPushButton[class="btn-green"]:disabled {
    background-color: #95a5a6;
    color: #ddd;
}

/* ---- Red action buttons (stop acquisition, replay stop) ---- */
QPushButton[class="btn-red"] {
    background-color: #e74c3c;
    color: white;
    font-weight: bold;
    border-radius: 4px;
    font-size: 13px;
    min-height: 24px;
}

QPushButton[class="btn-red"]:hover {
    background-color: #c0392b;
}

QPushButton[class="btn-red"]:pressed {
    background-color: #a93226;
}

QPushButton[class="btn-red"]:disabled {
    background-color: #95a5a6;
    color: #ddd;
}

/* ---- Device status labels ---- */
QLabel[class="status-running"] {
    font-weight: bold;
    color: #27ae60;
}

QLabel[class="status-stopped"] {
    font-weight: bold;
    color: #e74c3c;
}
